<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%URL}" field="url">
        <f:textbox/>
    </f:entry>
    <f:entry title="${%Enabled}" field="enabled">
        <f:checkbox default="true"/>
    </f:entry>
    <f:entry title="${%Notify on claim}" field="onClaim">
        <f:checkbox default="true"/>
    </f:entry>
    <f:entry title="${%Notify on unclaim}" field="onUnclaim">
        <f:checkbox default="true"/>
    </f:entry>
    <f:entry title="${%For tests}" field="forTests">
        <f:checkbox default="true"/>
    </f:entry>
    <f:entry title="${%For builds}" field="forBuilds">
        <f:checkbox default="true"/>
    </f:entry>
    <f:entry title="${%Secret}" field="secret">
        <f:password/>
    </f:entry>
    <f:entry title="${%Timeout (seconds)}" field="timeoutSeconds">
        <f:number default="5" min="1" max="60"/>
    </f:entry>
    <f:entry title="${%Payload format}" help="/plugin/claim/help-webhookPayload.html">
        ${%Click the help icon for the JSON structure sent to the webhook.}
    </f:entry>
    <f:validateButton title="${%Test webhook}" progress="${%Sending...}" method="testWebhook"
                      with="url,secret,timeoutSeconds"/>
    <f:entry>
        <div align="right"><f:repeatableDeleteButton/></div>
    </f:entry>
</j:jelly>
